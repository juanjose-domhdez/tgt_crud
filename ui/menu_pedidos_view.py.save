import flet as ft


def MenuPedidosView(on_seleccionar_opcion):
    
    card_pedido = ft.Container(
        content=ft.Column(
            [
                ft.Icon(ft.Icons.ADD_SHOPPING_CART, size=55, color=ft.Colors.AMBER_400),
                ft.Text(
                    "NUEVO PEDIDO",
                    size=20,
                    weight=ft.FontWeight.BOLD,
                    color=ft.Colors.WHITE
                ),
                ft.Text(
                    "Registrar un nuevo pedido",
                    color=ft.Colors.WHITE_54,
                    text_align=ft.TextAlign.CENTER,
                    size=13
                ),
                ft.ElevatedButton(
                    "Crear Pedido",
                    icon=ft.Icons.ARROW_FORWARD,
                    style=ft.ButtonStyle(
                        bgcolor=ft.Colors.AMBER_500,
                        color=ft.Colors.BLACK
                    ),
                    on_click=lambda _: on_seleccionar_opcion("pedido")
                )
            ],
            alignment=ft.MainAxisAlignment.CENTER,
            horizontal_alignment=ft.CrossAxisAlignment.CENTER,
            spacing=15
        ),
        padding=25,
        width=300,
        height=260,
        bgcolor="#1E293B",
        border_radius=15
    )


    card_medidas = ft.Container(
        content=ft.Column(
            [
                ft.Icon(ft.Icons.STRAIGHTEN, size=55, color=ft.Colors.AMBER_400),
                ft.Text(
                    "TOMA DE MEDIDAS",
                    size=20,
                    weight=ft.FontWeight.BOLD,
                    color=ft.Colors.WHITE
                ),
                ft.Text(
                    "Registrar medidas del cliente",
                    color=ft.Colors.WHITE_54,
                    text_align=ft.TextAlign.CENTER,
                    size=13
                ),
                ft.ElevatedButton(
                    "Abrir Medidas",
                    icon=ft.Icons.ARROW_FORWARD,
                    style=ft.ButtonStyle(
                        bgcolor=ft.Colors.AMBER_500,
                        color=ft.Colors.BLACK
                    ),
                    on_click=lambda _: on_seleccionar_opcion("medidas")
                )
            ],
            alignment=ft.MainAxisAlignment.CENTER,
            horizontal_alignment=ft.CrossAxisAlignment.CENTER,
            spacing=15
        ),
        padding=25,
        width=300,
        height=260,
        bgcolor="#1E293B",
        border_radius=15
    )


    return ft.Container(
        content=ft.Column(
            [
                ft.Text(
                    "MENÚ DE PEDIDOS",
                    size=24,
                    weight=ft.FontWeight.BOLD,
                    color=ft.Colors.AMBER_400
                ),
                ft.Text(
                    "Selecciona una opción:",
                    color=ft.Colors.WHITE_70
                ),
                ft.Container(height=20),
                ft.Row(
                    [card_pedido, card_medidas],
                    alignment=ft.MainAxisAlignment.CENTER,
                    spacing=40
                )
            ],
            horizontal_alignment=ft.CrossAxisAlignment.CENTER,
            alignment=ft.MainAxisAlignment.CENTER
        ),
        expand=True
    )

